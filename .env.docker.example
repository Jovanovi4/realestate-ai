# Copy to .env.docker, chmod 600, and set real values before running Compose.
# This file is also used for Compose variable substitution via --env-file.
PILOT_DOMAIN=
DJANGO_SECRET_KEY=
POSTGRES_DB=realestate_ai
POSTGRES_USER=realestate_ai
# Use a long random password made of URL-safe letters, digits, hyphen or underscore.
POSTGRES_PASSWORD=
TIME_ZONE=Europe/Moscow

# Enable integrations only after their private credentials and callbacks are ready.
AI_ENABLED=False
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none

EMAIL_NOTIFICATIONS_ENABLED=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

TELEGRAM_NOTIFICATIONS_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_PUBLIC_ENABLED=False
TELEGRAM_PUBLIC_BOT_TOKEN=
TELEGRAM_PUBLIC_BOT_USERNAME=
TELEGRAM_PUBLIC_WEBHOOK_SECRET=

TURNSTILE_ENABLED=False
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=

BILLING_SHADOW_ENABLED=True
BILLING_ENFORCEMENT_ENABLED=False

# Fill in actual operator information before allowing real customer data.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_INN=
LEGAL_OPERATOR_OGRN=
LEGAL_OPERATOR_ADDRESS=
LEGAL_PRIVACY_EMAIL=
LEGAL_DATA_STORAGE_LOCATION=
