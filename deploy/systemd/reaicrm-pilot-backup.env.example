# Copy to /etc/reaicrm-pilot-backup/restic.env, chmod 600, then replace placeholders.
# Values must be single-quoted and must not contain a single quote.
RESTIC_REPOSITORY='s3:https://storage.yandexcloud.net/PRIVATE_BUCKET_NAME/reaicrm-pilot'
RESTIC_PASSWORD_FILE='/etc/reaicrm-pilot-backup/password'
AWS_ACCESS_KEY_ID='REPLACE_WITH_SERVICE_ACCOUNT_KEY_ID'
AWS_SECRET_ACCESS_KEY='REPLACE_WITH_SERVICE_ACCOUNT_SECRET'
AWS_DEFAULT_REGION='ru-central1'
