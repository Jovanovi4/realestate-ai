[Unit]
Description=REAICRM pilot verified and encrypted offsite backup
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/reaicrm-pilot-backup/restic.env
Environment=REAICRM_PROJECT_ROOT=/home/deploy/realestate-ai
Environment=REAICRM_AUTOMATED_BACKUP_ROOT=/var/backups/reaicrm-pilot
ExecStart=/usr/bin/bash /usr/local/libexec/reaicrm-pilot/backup_offsite_pilot.sh
TimeoutStartSec=3h
