# Use these names as environment variables in your terminal or deployment settings.
# Never commit a real secret file.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
TIME_ZONE=Europe/Lisbon

# New-lead notifications. Email is sent to the address in each realtor profile.
# Telegram is sent to that profile's private Telegram chat ID.
EMAIL_NOTIFICATIONS_ENABLED=False
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Rieltor AI <notifications@example.com>

TELEGRAM_NOTIFICATIONS_ENABLED=False
TELEGRAM_BOT_TOKEN=

# Separate buyer-facing bot. Enable only after registering the HTTPS webhook.
TELEGRAM_PUBLIC_ENABLED=False
TELEGRAM_PUBLIC_BOT_TOKEN=
TELEGRAM_PUBLIC_BOT_USERNAME=
TELEGRAM_PUBLIC_WEBHOOK_SECRET=

# Public lead-form security. In production, use a shared cache when multiple
# Gunicorn workers or instances are running.
PUBLIC_LEAD_RATE_LIMIT=8
PUBLIC_LEAD_RATE_LIMIT_PER_PROPERTY=3
PUBLIC_LEAD_RATE_WINDOW_SECONDS=900
PUBLIC_FORMS_TRUST_X_FORWARDED_FOR=False
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=realestate-ai

# Account security: trust forwarded IPs only behind a proxy that replaces them.
AUTH_TRUST_X_FORWARDED_FOR=False
# Canonical origin for account emails; never derived from the incoming Host.
# For local testing use http://127.0.0.1:8000; production requires https.
ACCOUNT_PUBLIC_BASE_URL=https://example.com
# Production rate limits require a shared Redis cache (same CACHE_* settings):
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1

# Cloudflare Turnstile. Keep disabled until both keys and allowed hostnames are set.
TURNSTILE_ENABLED=False
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=example.com,www.example.com

# Legal documents. Replace every placeholder before publishing the service.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_INN=
LEGAL_OPERATOR_OGRN=
LEGAL_OPERATOR_ADDRESS=
LEGAL_PRIVACY_EMAIL=
LEGAL_DATA_STORAGE_LOCATION=
PERSONAL_DATA_POLICY_VERSION=2026-09-21
PERSONAL_DATA_CONSENT_VERSION=2026-09-21
SERVICE_TERMS_VERSION=2026-09-21

# Database and uploaded files. On Render use its DATABASE_URL and mount a disk
# at /var/data, then set DJANGO_MEDIA_ROOT=/var/data/media.
DATABASE_URL=
DJANGO_MEDIA_ROOT=
DJANGO_SERVE_MEDIA=False

# Image upload validation. MB means 1024 * 1024 bytes.
PROPERTY_IMAGE_MAX_MB=10
PROFILE_IMAGE_MAX_MB=5
IMAGE_UPLOAD_MAX_PIXELS=25000000
PROPERTY_IMAGES_PER_UPLOAD=10
PROPERTY_IMAGES_MAX_COUNT=30

# Archives: 3 calendar months before operator review, never automatic deletion.
CRM_ARCHIVE_REVIEW_MONTHS=3
# Private folder outside publicly served media/static. Must have mode 700.
CRM_BACKUP_ROOT=
# Review old backups after 30 days; commands do not prune them automatically.
CRM_BACKUP_REVIEW_DAYS=30
CRM_BACKUP_TIMEOUT_SECONDS=300

# AI assistant. Ollama is the default and requires a locally installed model.
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:3b

# Switch AI_PROVIDER to openai and add a real key only to your local environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Set False on the staging stand to hide and disable AI functionality.
AI_ENABLED=True

# Record resource/AI usage and prospective overages.
BILLING_SHADOW_ENABLED=True
# Keep tariff blocking off until the PostgreSQL race tests and rollout audit pass.
BILLING_ENFORCEMENT_ENABLED=False
